---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="404 - Page Not Found">
  <main class="min-h-screen flex items-center justify-center bg-background text-foreground font-mono">
    <div class="text-center space-y-4">
      <p class="text-6xl font-bold text-primary">404</p>
      <p class="text-xl text-muted-foreground">Page not found</p>
      <a href="/" class="text-primary hover:underline">Go home</a>
    </div>
  </main>
</BaseLayout>