---
import "../styles/global.css";
import NotFoundPage from "../components/NotFoundPage";

const initialPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/AG_Logo_Design_dark.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>404 - Query Returned No Results</title>
    <script is:inline>
      (function () {
        const stored = localStorage.getItem("theme");
        const theme = stored === "light" || stored === "dark" ? stored : "dark";
        document.documentElement.classList.add(theme);
      })();
    </script>
  </head>
  <body class="min-h-screen bg-background text-foreground font-mono transition-colors duration-300">
    <NotFoundPage client:load initialPath={initialPath} />
  </body>
</html>
