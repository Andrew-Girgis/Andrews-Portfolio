---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navigation from "../components/NavigationNew";
import ComingSoonPage from "../components/ComingSoonPage";
import Footer from "../components/FooterNew.astro";
---

<BaseLayout title="Writing - Andrew Girgis">
  <Navigation client:load />
  <main class="pt-20">
    <ComingSoonPage
      client:load
      command="ls ./writing"
      title="writing"
      description="Notes, essays, project writeups, and research thoughts."
    />
  </main>
  <Footer />
</BaseLayout>
